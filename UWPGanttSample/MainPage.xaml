<Page
    x:Class="UWPGanttSample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UWPGanttSample"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gantt="using:Syncfusion.UI.Xaml.Gantt"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ItemsSource: root tasks (hierarchy comes from each task's Children).
             DataContext is set in MainPage.xaml.cs. -->
        <gantt:SfGantt x:Name="Gantt"
                       ItemsSource="{Binding TaskCollection}"
                       ProjectResources="{Binding ResourceCollection}"
                       CriticalTaskBarBrush="Red"
                       HighlightCriticalTasks="True"
                       AllowEditing="True"
                       AllowSorting="True"
                       SelectionChanging="Gantt_SelectionChanging"
                       SelectionChanged="Gantt_SelectionChanged"
                       BeginCellEdit="Gantt_BeginCellEdit"
                       EndCellEdit="Gantt_EndCellEdit"
                       TaskExpanding="Gantt_TaskExpanding"
                       TaskExpanded="Gantt_TaskExpanded"
                       TaskCollapsing="Gantt_TaskCollapsing"
                       TaskCollapsed="Gantt_TaskCollapsed">
            <gantt:SfGantt.TimescaleSettings>
                <gantt:TimescaleSettings>
                    <gantt:TimescaleSettings.TopTier>
                        <gantt:TimescaleTier IntervalType="Weeks">
                        </gantt:TimescaleTier>
                    </gantt:TimescaleSettings.TopTier>
                    <gantt:TimescaleSettings.BottomTier>
                        <gantt:TimescaleTier IntervalType="Days"/>
                    </gantt:TimescaleSettings.BottomTier>
                </gantt:TimescaleSettings>
            </gantt:SfGantt.TimescaleSettings>
            <gantt:SfGantt.Holidays>
                <gantt:GanttHolidayCollection>
                    <gantt:GanttHoliday Day="{Binding Today}"
                                Background="CadetBlue" />
                </gantt:GanttHolidayCollection>
            </gantt:SfGantt.Holidays>
        </gantt:SfGantt>

        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Event Logger" FontSize="18" VerticalAlignment="Center"/>
                <Button Content="Clear Log" Click="ClearLog_Click"/>
                <Button Content="Copy Log" Click="CopyLog_Click"/>
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{x:Bind Log}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LogEntry">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0,4"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>